#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const DOCS_PATH = '{{DOCS_PATH}}';

function git(args) {
  try {
    return execFileSync('git', args, {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      timeout: 5000
    }).trim();
  } catch {
    return '';
  }
}

function main() {
  let data = {};
  try {
    const input = fs.readFileSync(0, 'utf8').trim();
    data = input ? JSON.parse(input) : {};
  } catch {
    data = {};
  }

  const cwd = data.cwd || process.cwd();
  const docsDir = path.join(cwd, DOCS_PATH);
  const branch = git(['branch', '--show-current']) || 'unknown';
  const status = git(['status', '--short']);
  const changed = status ? status.split('\n').map((line) => '- ' + line).join('\n') : '- No working tree changes';

  const content =
    '# Session Snapshot\n\n' +
    '> Auto-generated by CodexFlow Stop hook. Move useful details into SESSION_LOG.md.\n\n' +
    `**Date**: ${new Date().toISOString().slice(0, 10)}\n` +
    `**Branch**: ${branch}\n\n` +
    '## Working Tree\n\n' +
    changed +
    '\n';

  try {
    fs.mkdirSync(docsDir, { recursive: true });
    fs.writeFileSync(path.join(docsDir, '.session-snapshot.md'), content, 'utf8');
  } catch (err) {
    process.stderr.write('CodexFlow session snapshot failed: ' + err.message + '\n');
  }
}

main();
